<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Birleştirilmiş Tablo Ödevi</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
        }

        table {
            width: 400px;
            height: 200px;
            margin: 30px auto;
            border: 5px double #555;
            background-color: white;
        }

        td {
            border: 2px solid #555;
            text-align: center;
            vertical-align: middle;
            font-size: 28px;
            padding: 5px;
        }

        .yesil {
            background-color: green;
        }

        .turuncu {
            background-color: orange;
        }

        .mavi {
            background-color: blue;
        }

        .beyaz {
            background-color: white;
        }
    </style>
</head>

<body>

<table>
    <tr>
        <td class="beyaz">1</td>
        <td class="beyaz" colspan="3">2</td>
    </tr>

    <tr>
        <td class="beyaz" rowspan="4">3</td>
        <td class="yesil">4</td>
        <td class="turuncu">5</td>
        <td class="yesil" rowspan="2">6</td>
    </tr>

    <tr>
        <td class="yesil">7</td>
        <td class="turuncu">8</td>
    </tr>

    <tr>
        <td class="mavi" colspan="2">9</td>
        <td class="turuncu" rowspan="2">10</td>
    </tr>
</table>

</body>
</html>
